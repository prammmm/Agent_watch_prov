# Example Environment Configuration for AgentWatch
# Copy this file to .env and insert the appropriate API key before running hosted-model experiments.
# NEVER commit .env to version control.

# Supported Model Providers for AgentDojo Benchmarks
# At least one provider key is required to execute real LLM agent trajectories.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Hardware & Device Settings
AGENTWATCH_DEVICE=cuda:0
AGENTWATCH_REQUIRE_GPU=true
AGENTWATCH_LOG_LEVEL=INFO
